# ==============================================
# Javis Project - Unified Environment Configuration
# ==============================================

# Server Configuration
PORT=3009
NODE_ENV=development

# Read-Only Mode (set to 'true' for production/server deployment)
# When enabled, all write operations (create/update/delete) will be blocked
NEXT_PUBLIC_READ_ONLY=false

# ==============================================
# Database Configuration (PostgreSQL)
# ==============================================
DATABASE_HOST=localhost
DATABASE_PORT=5439
DATABASE_USER=javis
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=javis_brain

# PostgreSQL Connection (for pg Pool - Next.js)
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_USER=javis
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=javis_brain

# Database URL (PostgreSQL connection string)
DATABASE_URL=postgresql://javis:your_db_password@localhost:5439/javis_brain

# Legacy alias
DB_PORT=5439

# ==============================================
# Jira API Configuration
# ==============================================
JIRA_URL=https://your-org.atlassian.net
NEXT_PUBLIC_JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=your_jira_api_token

# JSM service-desk identifiers for POST /rest/servicedeskapi/request (raiseOnBehalfOf migration, kanban #2777)
# Look up via: GET {JIRA_URL}/rest/servicedeskapi/servicedesk and /rest/servicedeskapi/servicedesk/{id}/requesttype
JIRA_SERVICE_DESK_ID=1
JIRA_REQUEST_TYPE_ID_INTEGRATED_SYSTEM=4
JIRA_REQUEST_TYPE_ID_ABATEMENT=117

# ==============================================
# Bitbucket API Configuration
# ==============================================
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_API_TOKEN=your_bitbucket_api_token

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_DEFAULT_CHANNEL=#jarvis-alerts

# ==============================================
# EOB (Edwards Operation Board) SSO Configuration
# ==============================================
NEXT_PUBLIC_EOB_API_URL=https://your-eob-host
NEXT_PUBLIC_EOB_LOGIN_URL=https://your-eob-host/login
EOB_INTERNAL_API_URL=http://localhost:8004

ATLASSIAN_OAUTH_CLIENT_ID=your_atlassian_oauth_client_id
ATLASSIAN_OAUTH_CLIENT_SECRET=your_atlassian_oauth_client_secret
JAVIS_SESSION_SECRET=your_session_secret_hex

# ==============================================
# PCAS (AI Assist) Configuration
# ==============================================
# Set NEXT_PUBLIC_PCAS_ENABLED=true to show the AI writing assistant button in the service desk form
NEXT_PUBLIC_PCAS_ENABLED=false
# Base URL of the PCAS chat API (server-only, never exposed to client)
PCAS_API_URL=https://your-pcas-host
# Authentication token for PCAS API (server-only)
PCAS_API_TOKEN=your_pcas_api_token
# LLM model to use (defaults to gpt-4o-mini if unset)
PCAS_LLM_MODEL=gpt-4o-mini
